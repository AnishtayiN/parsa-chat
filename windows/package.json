{
  "author": "AnishtayiN",
  "build": {
    "appId": "com.anishtayin.parsachat",
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ParsaChat-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false
    },
    "productName": "Parsa Chat",
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis"
    }
  },
  "description": "Parsa Chat — realtime chat room desktop app (Windows 7/8/10/11)",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "parsa-chat",
  "scripts": {
    "dist:win": "electron-builder --win nsis",
    "start": "electron ."
  },
  "version": "2.1.0"
}